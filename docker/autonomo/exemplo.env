# Variáveis do ambiente autônomo SEM segredos (docs/ambiente-autonomo.md).
# Copie para .env nesta pasta (ignorado pelo git) e ajuste. Os tokens
# (CLAUDE_CODE_OAUTH_TOKEN, GH_TOKEN, CT_HUB_TOKEN, CT_HUB_AGENT_TOKEN) NUNCA
# vão aqui: entram pelo shell só no `docker compose up`.

# Versão da release do ctowerd/ctower (sem o "v") e do Claude Code.
CT_VERSION=1.8.0
CLAUDE_CODE_VERSION=stable

# Nome do ambiente no hub (o mesmo do `cthubd add-env`).
CT_ENV_NAME=linux-autonomo
# Hub (só na primeira subida). Hub nesta máquina: http://host.docker.internal:7879
CT_HUB_URL=http://hub.example.com:7879

# Conta do plano: copie de `claude auth status` num ambiente com login normal.
CTOWER_CLAUDE_ORG_ID=00000000-0000-0000-0000-000000000000
CTOWER_CLAUDE_EMAIL=fulano@example.com

# Autor dos commits das sessões.
CT_GIT_NAME=Fulano de Tal
CT_GIT_EMAIL=fulano@example.com

# 1 = sessões sem prompts de permissão (o container é o isolamento).
CT_AUTONOMO_SEM_PROMPTS=1
# Porta do ctowerd em 127.0.0.1 do host (só para o app desktop daqui).
CT_AUTONOMO_PORT=17880
