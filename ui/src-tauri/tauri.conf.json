{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control Tower",
  "version": "1.3.0",
  "identifier": "ai.deep-ion.control-tower",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Control Tower",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNEMyNzkzRUNCODMxMzIKUldReU1ianNreWRNMytyUlRLdHlVeDZHUVhpNzZUZGw5U0ZPZjl6L0lnQnNwZWZIVkZCRXBVYloK",
      "requireSignedVersion": true
    }
  }
}
